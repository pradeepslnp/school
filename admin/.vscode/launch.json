{
  // Two environments: dev and prod. These are --dart-define environments, not build flavors.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Admin web — dev",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "chrome",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--dart-define=API_BASE_URL=http://localhost:8080/api/v1"
      ]
    },
    {
      "name": "Admin web — prod",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "chrome",
      "args": [
        "--dart-define=ENVIRONMENT=production",
        // No production host exists yet. Replace this before anyone runs a prod build —
        // it is deliberately not a plausible-looking URL so it cannot be mistaken for one.
        "--dart-define=API_BASE_URL=https://REPLACE-ME.invalid/api/v1"
      ]
    }
  ]
}
