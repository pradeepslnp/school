<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP for local development only.

  Since Android 9 (API 28) cleartext is blocked by default, so `http://10.0.2.2:8080` from an
  emulator fails with `CLEARTEXT communication not permitted`. RestClient turns that into a
  transport failure, which the app displays as "offline" — the symptom looks like bad signal
  rather than a policy block.

  This file is under `src/dev/`, so it is compiled into the **dev flavor only**. The prod
  flavor never sees it and cannot make a cleartext request at all. The alternative,
  `android:usesCleartextTraffic="true"` on the application element, would apply to every
  build — and this app carries children's names, photos, and locations.

  `cleartextTrafficPermitted` is scoped to loopback addresses rather than opened globally,
  so even a dev build will not silently talk plaintext to a real host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator reaches the host machine at 10.0.2.2, not localhost. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!-- A physical handset on the same network needs your machine's LAN address. Add it
             here, e.g. <domain includeSubdomains="false">192.168.1.42</domain>, and pass a
             matching API_BASE_URL through the run configuration's dart-define.

             Note for editors: XML forbids a double hyphen inside a comment, so command-line
             flags cannot be written out in full here. AAPT2 fails the resource compile on
             one, and the message points at this file rather than at the comment. -->
    </domain-config>
</network-security-config>
