  },
  "syncSendingRecords": "Sending {count, plural, one{{count} record} other{{count} records}}…",
  "@syncSendingRecords": {
    "description": "Sync-status banner: online and actively draining the outbound queue.",
    "placeholders": {
      "count": {
        "type": "num",
        "example": "1"
      }
    }
  },
  "syncAllSent": "All records sent",
  "@syncAllSent": {
    "description": "Sync-status banner: queue empty, no last-synced time recorded yet on this device."
  },
  "syncAllSentJustNow": "All records sent · just now",
  "@syncAllSentJustNow": {
    "description": "Sync-status banner: queue empty, last drained under a minute ago."
  },
  "syncAllSentMinutesAgo": "All records sent · {minutes} min ago",
  "@syncAllSentMinutesAgo": {
    "description": "Sync-status banner: queue empty, last drained under an hour ago.",
    "placeholders": {
      "minutes": {
        "type": "num",
        "example": "12"
      }
    }
  },
  "syncAllSentHoursAgo": "All records sent · {hours} h ago",
  "@syncAllSentHoursAgo": {
    "description": "Sync-status banner: queue empty, last drained an hour or more ago.",
    "placeholders": {
      "hours": {
        "type": "num",
        "example": "3"
      }
    }
  },

  "languageSwitcherTooltip": "Change language",
