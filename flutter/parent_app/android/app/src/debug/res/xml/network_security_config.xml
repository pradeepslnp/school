<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP to a local backend, for debug builds only.

  This file lives under src/debug, so it is merged into debug builds and nothing else. A
  release build never sees it and keeps the platform default, which on targetSdk 28+ refuses
  cleartext outright.

  ## Why the exception is enumerated rather than global

  `cleartextTrafficPermitted="true"` with no domain list would permit http to *anywhere* — a
  misconfigured API_BASE_URL pointing at a staging host would then work, silently, over the
  clear, carrying a child's live location. Listing the loopback addresses means an http URL
  that is not the developer's own machine simply fails, loudly, at the first request.

  ## The three addresses

    10.0.2.2    the host machine as seen from the Android emulator. `localhost` inside an
                emulator is the emulator itself, which is why a backend running fine on the
                developer's laptop appears unreachable — this is the address to put in
                API_BASE_URL for emulator runs, not 127.0.0.1.
    10.0.3.2    the same thing for Genymotion.
    localhost   for a physical device port-forwarded with `adb reverse tcp:8080 tcp:8080`,
                and for tests running on the host.

  A device on the same Wi-Fi as the backend needs the machine's LAN address instead; add it
  here temporarily rather than widening the rule.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
