<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         Also declared in src/main so release builds have it — see the comment there.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- No cleartext exception here, deliberately.

         A profile build exists to measure the app as users will experience it, and a debug
         backend over http on loopback is not that. Profiling against a real https deployment
         is the point. If you genuinely need a profile run against a local server, copy
         src/debug/res/xml/network_security_config.xml into src/profile/res/xml and add the
         same android:networkSecurityConfig attribute here — temporarily, and not on a branch
         you intend to merge.
    -->
</manifest>
